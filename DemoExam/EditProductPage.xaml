<Page 
    x:Class="DemoExam.EditProductPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:DemoExam"
    Title="Страница Добавления / Редактирования товара"
    Loaded="Page_Loaded">
    <Page.DataContext>
        <Binding RelativeSource="{RelativeSource Self}"></Binding>
    </Page.DataContext>
    <Page.Resources>
        <ResourceDictionary Source="/Dictionary1.xaml"></ResourceDictionary>
    </Page.Resources>

    <ScrollViewer HorizontalAlignment="Center" VerticalAlignment="Center" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinWidth="500">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Text="Добавление / Редактирование товара"></TextBlock>
            
            <StackPanel Grid.Row="1" Orientation="Vertical">
                <Image Name="Image_Main" Width="100" Source="{Binding SelectedObject.ImagePathGetSet}"></Image>
                <Button Name="Button_ChangeImage" Click="Button_ChangeImage_Click">Сменить изображение</Button>
                <Button Name="Button_ClearImage" Click="Button_ClearImage_Click">Очистить изображение</Button>

                <TextBlock Text="Название" Margin="0"></TextBlock>
                <TextBox Name="TextBox_Name" Text="{Binding SelectedObject.Name, TargetNullValue=''}"></TextBox>

                <TextBlock Text="Цена" Margin="0"></TextBlock>
                <TextBox Name="TextBox_Price" Text="{Binding SelectedObject.Price, TargetNullValue=''}"></TextBox>

                <TextBlock Text="Тип" Margin="0"></TextBlock>
                <ComboBox Name="ComboBox_Type" SelectedItem="{Binding SelectedObject.Type}" DisplayMemberPath="Name" ItemsSource="{Binding ComboBoxTypes}"></ComboBox>

                <Button Name="Button_Save" Click="Button_Save_Click">Сохранить</Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
