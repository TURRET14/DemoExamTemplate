<Page x:Class="DemoExam.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DemoExam"
      mc:Ignorable="d"
      Title="Товары"
      Loaded="Page_Loaded">
    <Page.DataContext>
        <Binding RelativeSource="{RelativeSource Self}"></Binding>
    </Page.DataContext>
    <Page.Resources>
        <ResourceDictionary Source="/Dictionary1.xaml"></ResourceDictionary>
    </Page.Resources>

    <ScrollViewer HorizontalAlignment="Center" VerticalAlignment="Center" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinWidth="500">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Button Name="Button_Orders" Grid.Row="0" Click="Button_Orders_Click">Перейти к заказам</Button>

            <TextBlock Grid.Row="1" FontSize="20" FontWeight="Bold" Text="Товары"></TextBlock>

            <Grid Name="Grid_Actions" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Button Name="Button_Add" Grid.Row="0" Click="Button_Add_Click">Добавить товар</Button>
                <Button Name="Button_Delete" Grid.Row="1" Click="Button_Delete_Click">Удалить товар</Button>
            </Grid>


            <GroupBox Name="GroupBox_Filter" Grid.Row="3" Header="Поиск, сортировка и фильтрация">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Сортировка (По стоимости)"></TextBlock>
                    <ComboBox Name="ComboBox_Sort" Grid.Row="0" Grid.Column="1" SelectionChanged="ComboBox_Sort_SelectionChanged">
                        <ComboBoxItem>По убыванию</ComboBoxItem>
                        <ComboBoxItem>По возрастанию</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Фильтрация (По типу)"></TextBlock>
                    <ComboBox Name="ComboBox_Filter" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FilterDataList}" DisplayMemberPath="Name" SelectionChanged="ComboBox_Filter_SelectionChanged"></ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Поиск (По названию)"></TextBlock>
                    <TextBox Name="TextBox_Search" Grid.Row="2" Grid.Column="1" TextChanged="TextBox_Search_TextChanged"></TextBox>

                    <Button Name="Button_Filters_Clear" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Click="Button_Filters_Clear_Click">Сбросить фильтры</Button>
                </Grid>
            </GroupBox>

            <ListBox Name="ListBox_Main" Grid.Row="4" ItemsSource="{Binding MainDataList}" MouseDoubleClick="ListBox_Main_MouseDoubleClick" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBigPrice}" Value="True">
                                            <Setter Property="Grid.Background" Value="DarkRed"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>

                            <Image Grid.Row="0" Grid.Column="0" Width="50" Source="{Binding ImagePathGetSet}"></Image>

                            <Grid Grid.Row="0" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{} Название: {0}">
                                            <Binding Path="Name"></Binding>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Row="1">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{} Цена: {0}">
                                            <Binding Path="Price"></Binding>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Row="2">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{} Тип: {0}">
                                            <Binding Path="Type.Name"></Binding>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </ScrollViewer>
</Page>
